# =============================================================================
# 环境变量样例 —— 复制为 .env 后按需修改
#   cp .env.example .env
# 说明：默认配置（LLM_PROVIDER=echo）不需要任何密钥即可跑通全部测试与本地演示。
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 服务运行
# -----------------------------------------------------------------------------
APP_ENV=local                 # local | staging | prod
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
API_HOST=0.0.0.0
API_PORT=8000
# 七个服务的接口前缀（同一进程内挂载，也可拆分部署）
API_PREFIX_PLATFORM=/platform
API_PREFIX_PRODUCT=/product
API_PREFIX_COACHING=/coaching
API_PREFIX_MARKETING=/marketing
API_PREFIX_VOICE=/voice
API_PREFIX_GATEWAY=/gateway
API_PREFIX_FLOW=/flow

# -----------------------------------------------------------------------------
# 1.5 API 鉴权（生产硬开关：七个前缀零鉴权 = 后台敞开）
#     默认关闭：本地开发 / 单元测试 / demo 零配置可跑。
#     生产打开：API_AUTH_ENABLED=true + API_AUTH_KEYS=key1,key2
#     凭证两种任选其一：X-API-Key: <key> 或 Authorization: Bearer <key>
#     白名单（不带 key 也放行）：/health /ready /（探针）、/docs /openapi.json
#     /static/*（交互式文档，生产可在反代层再收紧）、/voice/callback/*
#     （有独立更强的回调鉴权 VOICE_CALLBACK_API_KEY）
#     轮换期可同时挂两把 key（新 key 先上、旧 key 后下）。
#     ⚠️ 开了开关却没配密钥 = fail-closed：所有受保护路径 401，而不是悄悄裸奔。
# -----------------------------------------------------------------------------
API_AUTH_ENABLED=false
API_AUTH_KEYS=

# -----------------------------------------------------------------------------
# 2. LLM 供应商配置
#    echo        —— 离线确定性实现，无需密钥，用于本地开发 / 单元测试（默认）
#    openai      —— 任何 OpenAI 兼容端点：DashScope(通义千问)、DeepSeek、Ollama、vLLM …
# -----------------------------------------------------------------------------
LLM_PROVIDER=echo

# 当 LLM_PROVIDER=openai 时生效
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60

# 向量化模型（OpenAI 兼容的 /embeddings 端点）
EMBEDDING_PROVIDER=local      # local（离线哈希向量，默认）| openai
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# -----------------------------------------------------------------------------
# 3. 状态持久化（LangGraph Checkpointer）
#    sqlite —— 默认，落盘到 .data/checkpoints.sqlite，零依赖
#    memory —— 仅进程内，重启丢状态，用于测试
#    postgres —— 生产推荐，需下方 PG 配置
#    ⚠️ 多 worker 部署必须 postgres（原因与 fail-fast 行为见 5.9 节）
# -----------------------------------------------------------------------------
CHECKPOINTER_BACKEND=sqlite
CHECKPOINTER_SQLITE_PATH=.data/checkpoints.sqlite

POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/zhudai_ai

# -----------------------------------------------------------------------------
# 4. 向量库
#    local  —— 默认，进程内 numpy + BM25，零依赖（数据由 seed 脚本灌入）
#    qdrant —— 生产推荐
# -----------------------------------------------------------------------------
VECTOR_BACKEND=local
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# -----------------------------------------------------------------------------
# 5. 业务数据
# -----------------------------------------------------------------------------
POLICY_DATA_DIR=.data/policies          # 产品政策/知识库文件目录
PROFILE_DATA_DIR=.data/profiles         # 客户画像（来自数据中台）
MARKETING_DATA_DIR=.data/marketing      # 素材模板 / 待激活客户 / 效果种子（项目七）
SQLITE_BUSINESS_PATH=.data/business.sqlite

# 检索相关性闸门（低于阈值即判"无政策依据"→ 拒答并转人工）
# 默认值针对离线 local-hash 向量 + 词项 Reranker 校准（实测无关问题 dense 约 0.2~0.3、
# 相关问题 ≥0.27 且 rerank ≥0.4）；换真实 Embedding 后必须重新校准，否则会误拒或误答
RAG_MIN_RERANK_SCORE=0.15
RAG_MIN_DENSE_SCORE=0.35

# -----------------------------------------------------------------------------
# 5.5 项目六：大模型推理网关与可观测评测平台
#     默认关闭：gateway_enabled=false 时业务直连 LLM，网关完全不参与（零风险上线）。
#     置 true 后业务调用统一过网关：路由 / 缓存 / 限流 / 配额 / 密钥轮转 /
#     成本核算 / span 级可观测 / 评测门禁全部生效，业务代码一行都不用改。
# -----------------------------------------------------------------------------
GATEWAY_ENABLED=false
GATEWAY_SQLITE_PATH=.data/gateway.sqlite

# 分档模型与复杂度路由阈值（<medium 走小模型，>large 走大模型）
GATEWAY_MODEL_SMALL=qwen-turbo
GATEWAY_MODEL_MEDIUM=qwen-plus
GATEWAY_MODEL_LARGE=qwen-max
GATEWAY_DEFAULT_TIER=medium
GATEWAY_TIER_THRESHOLD_MEDIUM=0.35
GATEWAY_TIER_THRESHOLD_LARGE=0.70
# 成本基线：算"成本治理省了多少"时的对照档位（默认按不做治理=全走大模型计）
GATEWAY_BASELINE_TIER=large

# 价格表（¥ / 1K tokens，输入价 / 输出价）—— 演示估值，生产按实际账单校准
GATEWAY_PRICE_SMALL_IN=0.0008
GATEWAY_PRICE_SMALL_OUT=0.0020
GATEWAY_PRICE_MEDIUM_IN=0.0040
GATEWAY_PRICE_MEDIUM_OUT=0.0120
GATEWAY_PRICE_LARGE_IN=0.0200
GATEWAY_PRICE_LARGE_OUT=0.0600

# 缓存：前缀缓存"精确命中"安全；语义缓存阈值必须"宁漏不错"且必须带 TTL
GATEWAY_CACHE_TTL_SECONDS=900
GATEWAY_PREFIX_CACHE_MAX_ENTRIES=512
GATEWAY_SEMANTIC_CACHE_MAX_ENTRIES=512
GATEWAY_SEMANTIC_CACHE_THRESHOLD=0.94

# 限流 / 配额 / 多密钥轮转
GATEWAY_RATE_LIMIT_PER_MINUTE=600
GATEWAY_RATE_LIMIT_BURST=120
GATEWAY_QUOTA_TOKENS_PER_SCOPE=2000000      # 超配额先降档保服务；已是最小档才报错
GATEWAY_API_KEYS=                            # 逗号分隔多密钥；留空则用 LLM_API_KEY
GATEWAY_KEY_COOLDOWN_SECONDS=60

# 上下文裁剪（去重 / 工具输出摘要化 / 历史分层压缩）
GATEWAY_MAX_CONTEXT_TOKENS=6000
GATEWAY_KEEP_RECENT_TURNS=6
GATEWAY_SUMMARIZE_CHARS=200

# 评测闭环：Golden Set → 与基线比 → 退化超阈值就拦发布
GATEWAY_EVAL_MAX_REGRESSION=0.02
GATEWAY_EVAL_GOLDEN_PATH=                    # 外部 jsonl 扩充用例集；留空用内置 10 条

# -----------------------------------------------------------------------------
# 5.6 项目七：销售素材推广与客户激活
#     公司没有内容自运营账号，获客第二条腿是业务员的社交传播（朋友圈/抖音/小红书）。
#     AI 只产出素材与建议，发布与对客沟通由业务员完成（发送走 HITL 人工审批）。
# -----------------------------------------------------------------------------
MARKETING_DEFAULT_CHANNEL=moments            # moments | douyin | xiaohongshu
MARKETING_DORMANT_DAYS=7                     # 超过多少天未互动视为沉睡客户
MARKETING_ACTIVATION_COOLDOWN_DAYS=3         # 同一客户两次激活的最小间隔（防骚扰）
MARKETING_MAX_ACTIVATION_PER_CUSTOMER=2      # 同一客户累计触达上限（防骚扰）

# -----------------------------------------------------------------------------
# 5.7 项目一：AI 实时语音对话智能客服（火山引擎 RTC）
#
#     音频走 RTC 的 UDP 通道（浏览器 ↔ 火山边缘节点 ↔ 云端 Agent），
#     Python 服务既不收也不发音频，只做三件事：
#       ① 签进房凭证  ② 下发会话配置  ③ 处理 LLM 回调
#
#     ⚠️ 最重要的两个前置条件：
#        1) VOICE_PUBLIC_BASE_URL 必须公网可达（本地开发用 ngrok），
#           否则 RTC 云端 POST 不到我们的服务 —— 表现是"日志正常但 AI 不说话"
#        2) 不配 RTC/VOLC 密钥时为 dry-run：请求只记录不下发，可完整演示与测试
# -----------------------------------------------------------------------------
VOICE_ENABLED=false                          # true = 真实开房；false = 演练（只记录不下发）
VOICE_DATA_DIR=.data/voice                   # 场景 / 提示词 / 会话库
VOICE_SQLITE_PATH=.data/voice/voice.sqlite

# --- 火山 RTC 应用凭证（控制台 → RTC → 应用管理）---
RTC_APP_ID=
RTC_APP_KEY=
RTC_REGION=cn-north-1
RTC_SERVICE=rtc
VOICE_TOKEN_TTL_SECONDS=86400                # 进房 Token 有效期，官方建议 ≤ 24 小时

# --- 火山 OpenAPI 签名凭证（控制台 → 访问控制 → 密钥管理）---
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=

# --- ASR：怎么听 ---
VOICE_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
# 热词：业务专有名词，通用模型很容易听错（语音没有"重看一遍"的机会）
VOICE_HOTWORDS=债务置换,公积金信用贷,征信报告,社保,保单,负债优化

# --- TTS：怎么说 ---
VOICE_TTS_APP_ID=
VOICE_TTS_CLUSTER=volcano_tts                # 预置音色 volcano_tts / 复刻音色 volcano_icl
VOICE_TTS_VOICE_TYPE=                        # 复刻音色形如 S_xxxxx；留空用预置音色

# --- LLM：怎么想（第三方回调 → 指向我们自己的服务）---
VOICE_LLM_MODEL=doubao-seed-1-6-flash
VOICE_PUBLIC_BASE_URL=                       # 例：https://xxxx.ngrok-free.app（不带路径）
VOICE_CALLBACK_API_KEY=                      # 生产必填，否则公网回调地址等于免费大模型代理
VOICE_MAX_TOKENS=220                         # 语音回复上限（代码里夹在 150~300）
VOICE_TEMPERATURE=0.3
VOICE_HISTORY_TURNS=6                        # 下发给云端的历史轮数

# --- 检索策略（语音与文本口径不同：条数更少、闸门更严）---
VOICE_KNOWLEDGE_LIMIT=2                      # 注入几条知识片段（1-3 最佳）
VOICE_KNOWLEDGE_MAX_CHARS=900                # 知识块长度硬预算
VOICE_MIN_RELEVANCE=0.25                     # 相关性闸门，低于即转人工
VOICE_RERANK_ENABLED=true
VOICE_DENSE_WEIGHT=0.5

# --- 评测准入 ---
VOICE_EVAL_MAX_REGRESSION=0.03               # 平均分允许的退化幅度

# -----------------------------------------------------------------------------
# 5.8 项目八：助贷业务流程数字员工（状态机 + SOP + 审批边界）
# -----------------------------------------------------------------------------
FLOW_ENABLED=true                            # false = 不装配流程 Agent（默认预留）
FLOW_DATA_DIR=.data/flow                     # 线索库 / 幂等键 / 锁 / 审批 / 审计
FLOW_SQLITE_PATH=.data/flow/flow.sqlite

# --- SLA（超过即进"漏跟进"预警，改之前先跟业务主管对齐口径）---
FLOW_FIRST_CALL_SLA_MINUTES=30               # 线索分配后多久内必须完成首呼
FLOW_WECHAT_SLA_HOURS=2                      # 首呼后多久内必须加微
FLOW_FOLLOWUP_SLA_HOURS=24                   # 跟进间隔超过多久算停滞
FLOW_INVITE_CONFIRM_SLA_HOURS=4              # 邀约后多久内必须确认到店时间

# --- 费用口径（等额本息 + 服务费分档，改口径会改变对客报价）---
FLOW_DEFAULT_LOAN_MONTHS=36                  # 利息试算默认期数
FLOW_DEFAULT_ANNUAL_RATE=0.072               # 利息试算默认年化（助贷常见 7.2%）
FLOW_SERVICE_FEE_RATE=0.03                   # 服务费率：< 30 万档 3%
FLOW_FEE_RATE_LARGE_LOAN=0.02                # 服务费率：≥ 30 万档 2%
FLOW_LARGE_LOAN_THRESHOLD=300000             # 大额档门槛（放款金额 ≥ 该值）

# --- 可靠性与边界 ---
FLOW_READINESS_WARN_MINUTES=10               # 到店前多久还没准备就绪 → 告警
FLOW_IDEMPOTENCY_TTL_HOURS=24                # 幂等键保留时长（客户重复提交的窗口）
FLOW_LOCK_TTL_SECONDS=30                     # 分布式锁租约（秒），持锁方崩了自动释放
FLOW_HIGH_RISK_ACTIONS=send_contract,confirm_fee  # 必须走 HITL 审批的动作，勿删
FLOW_EVAL_MAX_REGRESSION=0.03                # 流程行为评测允许的退化幅度

# --- 定时扫描（SOP 调度器：漏跟进在超时那一刻被发现，而不是月底复盘）---
FLOW_SCHEDULER_ENABLED=false                 # 生产/compose 置 true；本地与测试保持 false
FLOW_SCHEDULER_INTERVAL_SECONDS=300          # 扫描间隔（秒），下限 10s

# --- 通知渠道（预警 / 审批单主动触达人，而不是等人打开后台）---
FLOW_NOTIFY_WEBHOOK_URL=                     # 企微/钉钉机器人 webhook；留空 = 只写日志
FLOW_NOTIFY_TIMEOUT_SECONDS=3                # 通知超时（秒）；失败只记日志，绝不拖垮扫描

# -----------------------------------------------------------------------------
# 5.9 多 Worker 部署（副本数 > 1 时，下面两项是硬要求，不是优化项）
#
#   ① 分布式锁换 Redis：SQLite 锁只在本进程内互斥。多 worker 下两条请求同时
#      改同一条线索会双双拿到锁 —— 重复建单/重复放款类事故就是这么来的。
#      Redis 版三件套：SET NX PX（互斥+租约）/ Lua 比 owner 再 DEL（原子释放，
#      不会误放别人的锁）/ Lua 比 owner 再 PEXPIRE（续约）。
#      ⚠️ fail-closed：Redis 连不上返回 503「未做任何修改，重试安全」，
#         绝不静默降级 SQLite —— 跨进程互斥已失效还给人"锁在工作"的错觉，
#         比明确失败危险得多。
#
#   ② Checkpointer 换 PG：HITL 审批挂起后若 resume 落到另一个副本，
#      memory/sqlite 存根取不到状态，表现为"审批通过了但流程没继续"（无报错，
#      只有业务结果错）。配错直接启动失败并给出排查指引，同样不静默降级。
#
#   验证是否真的换成功了：GET /flow/stats 看 lock_backend 字段
#   （RedisLockBackend / SqliteLockBackend），/ready 看 checkpointer 后端。
# -----------------------------------------------------------------------------
FLOW_LOCK_BACKEND=sqlite                     # sqlite（单机默认）| redis（多 worker 必须）
REDIS_URL=redis://localhost:6379/0          # 含密码：redis://:password@host:6379/0
FLOW_LOCK_TTL_SECONDS=30                     # 锁租约（秒），持锁方崩了自动释放
CHECKPOINTER_BACKEND=postgres                # 多 worker 必须 postgres（配 DSN，见第 3 组）
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/zhudai_ai

# -----------------------------------------------------------------------------
# 5.10 可观测：Prometheus 指标端点
#       GET /metrics（text/plain; version=0.0.4，无需 API Key —— 抓取端带 key
#       很别扭，生产请在反代层按来源 IP 收紧）。指标族：
#       app_info / runtime / gateway_* / flow_* / scheduler_* / data_*。
#       采集失败也返回 200 —— 监控接口不能成为故障源。
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# 5.11 项目四：助贷对话数据中台
#      数据流：微信 SQLite（只读）→ 原始层（不可变）→ 清洗脱敏 → 人工审核
#              → 四格式导出 / 向量切片与知识文章
#
#      DATA_SOURCE_PATH 不存在时自动退回 POLICY_DATA_DIR/conversations.jsonl，
#      所以没有微信库也能跑通；scripts/seed_data.py 会生成同结构的夹具库。
#      DATA_AUTO_INGEST 只控制"装配时是否自动跑一轮"，抽取本身是幂等的。
# -----------------------------------------------------------------------------
DATA_PLATFORM_DATA_DIR=.data/data_platform
DATA_PLATFORM_SQLITE_PATH=.data/data_platform/data_platform.sqlite
DATA_SOURCE_PATH=.data/data_platform/wechat_source.sqlite   # 微信 MSG 库（只读打开）
DATA_EXPORT_DIR=.data/data_platform/exports
DATA_WINDOW_MINUTES=5            # 会话切块时间窗（相邻消息间隔超过即断开）
DATA_MIN_CHARS=6                 # 过短阈值（有效字符数）
DATA_HIGH_VALUE_QUALITY=0.70     # 高价值质量分阈值
DATA_CHUNK_CHARS=300             # 知识切片长度（字符）
DATA_CHUNK_OVERLAP=60            # 切片重叠（字符）
DATA_AUTO_INGEST=true            # 首次启动且原始层为空时自动抽取
DATA_FEED_ENABLED=true           # 已审核对话优先作为项目七的案例语料源

# -----------------------------------------------------------------------------
# 6. 平台治理阈值（对应"失败自愈 / 成本治理"）
# -----------------------------------------------------------------------------
MAX_AGENT_STEPS=12            # 单次任务最大步数，超出即熔断转人工
MAX_AGENT_TOKENS=60000        # 单次任务 token 预算上限
TOOL_MAX_RETRIES=3            # 工具调用最大重试次数
TOOL_RETRY_BASE_SECONDS=0.2   # 指数退避基数
CIRCUIT_FAILURE_THRESHOLD=5   # 熔断器：连续失败阈值
CIRCUIT_RESET_SECONDS=30      # 熔断器：半开探测间隔
APPROVAL_TIMEOUT_SECONDS=300  # HITL 审批超时（秒）
APPROVAL_TIMEOUT_STRATEGY=abort   # abort（放弃）| escalate（升级提醒挂起）
